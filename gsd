# ── Subcommand Functions ───────────────────────────────────────────────────────

# cmd_status — show the GSD pipeline status dashboard
cmd_status() {
  local verbose="${VERBOSE:-false}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --verbose|-v) verbose=true; shift ;;
      --help|-h)    status_usage; return 0 ;;
      --json)
        JSON_OUTPUT=true
        RED='' GREEN='' YELLOW='' BLUE='' CYAN=''
        BOLD='' DIM='' BOLD_RED='' RESET=''
        shift ;;
      --)           shift; break ;;
      -*)           die_usage "Unknown option for 'status': $1" ;;
      *)            break ;;
    esac
  done

  # Gather data
  get_sessions
  local running_json
  running_json=$(get_running_sessions)
  local completed_json
  completed_json=$(get_completed_sessions)

  # Parse running sessions into arrays
  local running_count
  running_count=$(printf '%s' "${running_json}" | jq 'length' 2>/dev/null) || running_count=0

  local completed_count
  completed_count=$(printf '%s' "${completed_json}" | jq 'length' 2>/dev/null) || completed_count=0

  # Parse queue items (tab-delimited: status\tname\tdescription)
  local queue_items=()
  local queue_count=0
  if [[ -f "${QUEUE_FILE}" ]]; then
    while IFS=$'\t' read -r q_status q_name q_desc; do
      # Only include active items (queued or in_progress)
      if [[ "${q_status}" == "queued" || "${q_status}" == "in_progress" ]]; then
        queue_items+=("${q_status}	${q_name}	${q_desc}")
        (( queue_count++ )) || true
      fi
    done < <(get_queue_items 2>/dev/null || true)
  fi

  # Check for stuck sessions
  local stuck_count=0

  # JSON output mode
  if [[ "${JSON_OUTPUT:-false}" == "true" ]]; then
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    # Build queue JSON safely by converting tab-delimited output to JSON
    local all_queue_items
    all_queue_items=$(get_queue_items 2>/dev/null | \
      jq -Rr 'split("\t") | if length >= 2 then
        {status: .[0], name: .[1], description: (.[2] // "")}
      else empty end' 2>/dev/null | \
      jq -sc '.' 2>/dev/null) || all_queue_items="[]"
    [[ "${all_queue_items}" == "null" || -z "${all_queue_items}" ]] && all_queue_items="[]"

    jq -n \
      --arg timestamp "${timestamp}" \
      --argjson running_count "${running_count}" \
      --argjson stuck_count "${stuck_count}" \
      --argjson queue_count "${queue_count}" \
      --argjson sessions_running "${running_json}" \
      --argjson sessions_completed "${completed_json}" \
      --argjson queue "${all_queue_items}" \
      '{
        timestamp: $timestamp,
        summary: {
          running: $running_count,
          stuck: $stuck_count,
          queued: $queue_count
        },
        sessions: {
          running: $sessions_running,
          stuck: []
        },
        queue: $queue,
        completed: $sessions_completed
      }'
    return 0
  fi

  # Human-readable output
  printf '%s%s GSD Status%s\n' "${BOLD}" "📊" "${RESET}"
  printf '%s%s%s\n\n' "${DIM}" "$(printf '%.0s─' {1..60})" "${RESET}"

  # Summary counts
  local running_color="${GREEN}"
  local stuck_color="${RED}"
  local queue_color="${YELLOW}"

  printf '%s%d running%s  %s%d stuck%s  %s%d queued%s\n\n' \
    "${running_color}" "${running_count}" "${RESET}" \
    "${stuck_color}" "${stuck_count}" "${RESET}" \
    "${queue_color}" "${queue_count}" "${RESET}"

  # Empty state
  if [[ "${running_count}" -eq 0 ]] && [[ "${queue_count}" -eq 0 ]] && [[ "${completed_count}" -eq 0 ]]; then
    printf '%sNo active sessions. Queue is empty. All clear!%s\n' "${DIM}" "${RESET}"
    return 0
  fi

  if [[ "${verbose}" == "true" ]]; then
    # Verbose: full tables
    if [[ "${running_count}" -gt 0 ]]; then
      print_header "Running Sessions"
      print_table_header "%-20s %-10s %-8s %-12s %-15s" \
        "SESSION" "STATUS" "PID" "DURATION" "LOG ACTIVITY"
      while IFS=$'\t' read -r sess status pid dur updated; do
        local short_sess
        short_sess=$(truncate_str "${sess}" 20)
        printf '%-20s %-10s %-8s %-12s %-15s\n' \
          "${short_sess}" "${status}" "${pid}" "${dur}" "${updated}"
      done < <(printf '%s' "${running_json}" | jq -r '.[] | [
        (.title // .id // "unknown"),
        "running",
        "N/A",
        "N/A",
        (.updated // 0 | . / 1000 | todate)
      ] | @tsv' 2>/dev/null)
      printf '\n'
    fi

    if [[ "${queue_count}" -gt 0 ]]; then
      print_header "Queue"
      print_table_header "%-12s %-25s %s" "STATUS" "NAME" "DESCRIPTION"
      for item in "${queue_items[@]}"; do
        local s n d
        IFS=$'\t' read -r s n d <<< "${item}"
        local color
        case "${s}" in
          in_progress) color="${GREEN}" ;;
          queued)      color="${YELLOW}" ;;
          *) color="${RESET}" ;;
        esac
        local short_n
        short_n=$(truncate_str "${n}" 25)
        printf '%s%-12s %-25s %s%s\n' "${color}" "${s}" "${short_n}" "${d}" "${RESET}"
      done
      printf '\n'
    fi

    if [[ "${completed_count}" -gt 0 ]]; then
      print_header "Completed (last 5)"
      print_table_header "%-20s %-10s %s" "SESSION" "STATUS" "FINISHED"
      while IFS=$'\t' read -r sess status finished; do
        local short_sess color
        short_sess=$(truncate_str "${sess}" 20)
        case "${status}" in
          done|completed|finished) color="${DIM}" ;;
          failed) color="${RED}" ;;
          *) color="${DIM}" ;;
        esac
        printf '%s%-20s %-10s %s%s\n' "${color}" "${short_sess}" "${status}" "${finished}" "${RESET}"
      done < <(printf '%s' "${completed_json}" | jq -r '.[] | [
        (.title // .id // "unknown"),
        "done",
        (.updated // 0 | . / 1000 | todate)
      ] | @tsv' 2>/dev/null)
      printf '\n'
    fi

  else
    # Compact view
    if [[ "${running_count}" -gt 0 ]]; then
      print_header "Running"
      while IFS= read -r sess; do
        printf '  %s●%s %s\n' "${GREEN}" "${RESET}" "${sess}"
      done < <(printf '%s' "${running_json}" | jq -r '.[] | (.title // .id // "unknown")' 2>/dev/null)
      printf '\n'
    else
      printf '%sNo running sessions%s\n\n' "${DIM}" "${RESET}"
    fi

    if [[ "${queue_count}" -gt 0 ]]; then
      print_header "Queued"
      local shown=0
      for item in "${queue_items[@]}"; do
        if [[ "${shown}" -ge 3 ]]; then
          printf '  %s... and %d more%s\n' "${DIM}" "$(( queue_count - shown ))" "${RESET}"
          break
        fi
        local s n d
        IFS=$'\t' read -r s n d <<< "${item}"
        local icon
        case "${s}" in
          in_progress) icon="⟳" ;;
          *) icon="○" ;;
        esac
        printf '  %s %s\n' "${icon}" "${n}"
        (( shown++ )) || true
      done
      printf '\n'
    fi

    if [[ "${completed_count}" -gt 0 ]]; then
      print_header "Recently Completed"
      while IFS= read -r line; do
        printf '  %s✓%s %s\n' "${DIM}" "${RESET}" "${line}"
      done < <(printf '%s' "${completed_json}" | jq -r '.[] | (.title // .id // "unknown") + " (done)"' 2>/dev/null)
      printf '\n'
    fi
  fi
}

# cmd_queue — pretty-print QUEUE.md
cmd_queue() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h) queue_usage; return 0 ;;
      --json)
        JSON_OUTPUT=true
        # Disable colors in JSON mode (§3.1.5)
        RED='' GREEN='' YELLOW='' BLUE='' CYAN=''
        BOLD='' DIM='' BOLD_RED='' RESET=''
        shift ;;
      --)        shift; break ;;
      -*)        die_usage "Unknown option for 'queue': $1" ;;
      *)         break ;;
    esac
  done

  # File check MUST come before any display output (§2.2.6)
  if [[ ! -f "${QUEUE_FILE}" ]]; then
    die "Queue file not found: ${QUEUE_FILE}"
  fi

  # JSON output branch (§3.5 + §2.2)
  if [[ "${JSON_OUTPUT:-false}" == "true" ]]; then
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local items_json
    items_json=$(get_queue_items | \
      jq -Rr 'split("\t") | if length >= 2 then {status: .[0], name: .[1], description: (.[2] // "")} else empty end' | \
      jq -sc '.')
    jq -n \
      --arg timestamp "${timestamp}" \
      --arg queue_file "${QUEUE_FILE}" \
      --argjson items "${items_json}" \
      '{timestamp: $timestamp, queue_file: $queue_file, items: $items}'
    return 0
  fi

  # Human-readable output
  printf '%sQueue: %s%s\n' "${BOLD}" "${QUEUE_FILE}" "${RESET}"
  printf '%s%s%s\n\n' "${DIM}" "$(printf '%.0s─' {1..60})" "${RESET}"

  local in_progress_items=()
  local queued_items=()
  local done_items=()
  local failed_items=()

  # Collect items from get_queue_items into section arrays
  # Use process substitution — NOT pipe-to-while (Pitfall #2)
  local q_status q_name q_desc
  while IFS=$'\t' read -r q_status q_name q_desc; do
    case "${q_status}" in
      in_progress) in_progress_items+=("${q_name}"$'\t'"${q_desc}") ;;
      queued)      queued_items+=("${q_name}"$'\t'"${q_desc}") ;;
      done)        done_items+=("${q_name}"$'\t'"${q_desc}") ;;
      failed)      failed_items+=("${q_name}"$'\t'"${q_desc}") ;;
    esac
  done < <(get_queue_items)

  # Print each non-empty section
  local section_name item short_name item_desc
  if [[ ${#in_progress_items[@]} -gt 0 ]]; then
    print_header "In Progress"
    for item in "${in_progress_items[@]}"; do
      short_name=$(truncate_str "${item%%$'\t'*}" 30)
      item_desc="${item#*$'\t'}"
      if [[ -n "${item_desc}" ]]; then
        printf '  %s⟳ %s: %s%s\n' "${GREEN}" "${short_name}" "${item_desc}" "${RESET}"
      else
        printf '  %s⟳ %s%s\n' "${GREEN}" "${short_name}" "${RESET}"
      fi
    done
    printf '\n'
  fi

  if [[ ${#queued_items[@]} -gt 0 ]]; then
    print_header "Queued"
    for item in "${queued_items[@]}"; do
      short_name=$(truncate_str "${item%%$'\t'*}" 30)
      item_desc="${item#*$'\t'}"
      if [[ -n "${item_desc}" ]]; then
        printf '  %s○ %s: %s%s\n' "${YELLOW}" "${short_name}" "${item_desc}" "${RESET}"
      else
        printf '  %s○ %s%s\n' "${YELLOW}" "${short_name}" "${RESET}"
      fi
    done
    printf '\n'
  fi

  if [[ ${#done_items[@]} -gt 0 ]]; then
    print_header "Done"
    for item in "${done_items[@]}"; do
      short_name=$(truncate_str "${item%%$'\t'*}" 30)
      item_desc="${item#*$'\t'}"
      if [[ -n "${item_desc}" ]]; then
        printf '  %s✓ %s: %s%s\n' "${DIM}" "${short_name}" "${item_desc}" "${RESET}"
      else
        printf '  %s✓ %s%s\n' "${DIM}" "${short_name}" "${RESET}"
      fi
    done
    printf '\n'
  fi

  if [[ ${#failed_items[@]} -gt 0 ]]; then
    print_header "Failed"
    for item in "${failed_items[@]}"; do
      short_name=$(truncate_str "${item%%$'\t'*}" 30)
      item_desc="${item#*$'\t'}"
      if [[ -n "${item_desc}" ]]; then
        printf '  %s✗ %s: %s%s\n' "${RED}" "${short_name}" "${item_desc}" "${RESET}"
      else
        printf '  %s✗ %s%s\n' "${RED}" "${short_name}" "${RESET}"
      fi
    done
    printf '\n'
  fi

  # No items found case
  if [[ ${#in_progress_items[@]} -eq 0 ]] && \
     [[ ${#queued_items[@]} -eq 0 ]] && \
     [[ ${#done_items[@]} -eq 0 ]] && \
     [[ ${#failed_items[@]} -eq 0 ]]; then
    printf '%sNo items found in %s%s\n' "${DIM}" "${QUEUE_FILE}" "${RESET}"
  fi

  # Summary line
  local active_count=$(( ${#in_progress_items[@]} + ${#queued_items[@]} ))
  printf '\n%s%d active item(s)%s\n' "${DIM}" "${active_count}" "${RESET}"
}

# cmd_stuck — find stuck opencode sessions
cmd_stuck() {
  local kill_stuck=false
  local force=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --kill|-k)
        kill_stuck=true; shift ;;
      --force|-f)
        force=true; shift ;;
      --threshold|-t)
        if [[ -z "${2:-}" ]]; then
          die_usage "Option $1 requires a numeric argument"
        fi
        if [[ ! "${2}" =~ ^[0-9]+$ ]]; then
          die_usage "Invalid threshold value '${2}': must be a positive integer"
        fi
        STUCK_THRESHOLD_MIN="$2"
        shift 2
        ;;
      --json)
        JSON_OUTPUT=true
        # Disable colors in JSON mode (§3.1.5)
        RED='' GREEN='' YELLOW='' BLUE='' CYAN=''
        BOLD='' DIM='' BOLD_RED='' RESET=''
        shift ;;
      --help|-h)
        stuck_usage; return 0 ;;
      --)
        shift; break ;;
      -*)
        die_usage "Unknown option for 'stuck': $1" ;;
      *)
        break ;;
    esac
  done

  # Step 1: Scan PID files and collect stuck processes
  local stuck_pids=()
  local stuck_names=()
  local stuck_runtimes=()
  local stuck_staleness=()

  for pid_file in "${LOG_DIR}"/gsd-*-pid; do
    [[ -f "${pid_file}" ]] || continue

    # Extract session name from path: /tmp/gsd-SESSIONNAME-pid → SESSIONNAME
    local session
    session="${pid_file##*/gsd-}"
    session="${session%-pid}"

    local status
    status=$(check_stuck "${session}")
    # check_stuck() sets globals STUCK_RUNTIME and STUCK_LOG_STALENESS

    if [[ "${status}" == "stuck" ]]; then
      local pid
      pid=$(< "${pid_file}")
      stuck_pids+=("${pid}")
      stuck_names+=("${session}")
      stuck_runtimes+=("${STUCK_RUNTIME}")
      stuck_staleness+=("${STUCK_LOG_STALENESS}")
    fi
    # not_running/not_found: check_stuck() already cleaned up stale PID files (§2.3.8, §5.9)
  done

  # Step 2: JSON output mode (§2.3 + §3.5)
  if [[ "${JSON_OUTPUT:-false}" == "true" ]]; then
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local stuck_json="[]"
    if [[ ${#stuck_pids[@]} -gt 0 ]]; then
      local i
      stuck_json="["
      for (( i=0; i<${#stuck_pids[@]}; i++ )); do
        local item_json
        item_json=$(jq -n \
          --arg pid "${stuck_pids[${i}]}" \
          --arg session "${stuck_names[${i}]}" \
          --argjson runtime "${stuck_runtimes[${i}]}" \
          --argjson log_staleness "${stuck_staleness[${i}]}" \
          '{pid: $pid, session: $session, runtime_seconds: $runtime, log_staleness_seconds: $log_staleness}')
        if [[ "${i}" -gt 0 ]]; then
          stuck_json+=","
        fi
        stuck_json+="${item_json}"
      done
      stuck_json+="]"
    fi
    jq -n \
      --arg timestamp "${timestamp}" \
      --argjson threshold_minutes "${STUCK_THRESHOLD_MIN}" \
      --argjson stuck "${stuck_json}" \
      '{timestamp: $timestamp, threshold_minutes: $threshold_minutes, stuck: $stuck}'
    return 0
  fi

  # Step 3: No stuck processes case (§2.3.9)
  if [[ "${#stuck_pids[@]}" -eq 0 ]]; then
    printf '%sNo stuck processes detected.%s\n' "${GREEN}" "${RESET}"
    printf '%s(threshold: %dm, checks CPU activity)%s\n' "${DIM}" "${STUCK_THRESHOLD_MIN}" "${RESET}"
    return 0
  fi

  # Step 4: Display stuck processes table
  print_header "Stuck Processes (threshold: ${STUCK_THRESHOLD_MIN}m)"
  print_table_header "%-8s %-25s %-12s %-15s" "PID" "SESSION" "RUNTIME" "LOG IDLE"

  local i
  for (( i=0; i<${#stuck_pids[@]}; i++ )); do
    local short_session
    short_session=$(truncate_str "${stuck_names[${i}]}" 25)
    local runtime_fmt
    runtime_fmt=$(format_duration "${stuck_runtimes[${i}]}")
    local staleness_fmt
    staleness_fmt=$(format_duration "${stuck_staleness[${i}]}")
    printf '%s%-8s %-25s %-12s %-15s%s\n' \
      "${BOLD_RED}" \
      "${stuck_pids[${i}]}" \
      "${short_session}" \
      "${runtime_fmt}" \
      "${staleness_fmt}" \
      "${RESET}"
  done
  printf '\n'

  # Step 5: Kill workflow (§2.3.5, §2.3.6, §2.3.7, §5.8)
  if [[ "${kill_stuck}" == "true" ]]; then
    # Confirmation prompt (skip if force=true)
    if [[ "${force}" == "false" ]]; then
      # Only prompt if stdin is a TTY (Pitfall #3 — don't hang in non-interactive)
      if [[ ! -t 0 ]]; then
        die "Cannot prompt for confirmation in non-interactive mode. Use --force to skip."
      fi
      printf '%sWill send SIGTERM to %d stuck process(es) listed above.%s\n' "${BOLD_RED}" "${#stuck_pids[@]}" "${RESET}"
      local confirm
      read -r -p "Kill these processes? [y/N]: " confirm
      if [[ "${confirm}" != "y" && "${confirm}" != "Y" ]]; then
        printf 'Aborted.\n'
        return 0
      fi
    fi

    printf '\n'
    for (( i=0; i<${#stuck_pids[@]}; i++ )); do
      local pid="${stuck_pids[${i}]}"
      local session="${stuck_names[${i}]}"
      # Re-verify alive before kill (§2.3.7) — process may have exited since we scanned
      if kill -0 "${pid}" 2>/dev/null; then
        kill "${pid}"  # SIGTERM only (§5.8) — never SIGKILL automatically
        printf '%sKilled PID %s (session: %s)%s\n' "${GREEN}" "${pid}" "${session}" "${RESET}"
        rm -f "${LOG_DIR}/gsd-${session}-pid"  # Clean up PID file after successful kill
      else
        printf '%sPID %s (session: %s) already exited%s\n' "${DIM}" "${pid}" "${session}" "${RESET}"
        rm -f "${LOG_DIR}/gsd-${session}-pid"  # Clean up stale PID file
      fi
    done
  fi
}

# cmd_log — show a readable session transcript
cmd_log() {
  local session=""
  local end_of_opts=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h) log_usage; return 0 ;;
      --json)
        JSON_OUTPUT=true
        RED='' GREEN='' YELLOW='' BLUE='' CYAN=''
        BOLD='' DIM='' BOLD_RED='' RESET=''
        shift ;;
      --) end_of_opts=true; shift; break ;;
      -*) die_usage "Unknown option for 'log': $1" ;;
      *)
        # First non-flag arg is the session name
        if [[ -z "${session}" ]]; then
          session="$1"
          shift
        else
          break
        fi
        ;;
    esac
  done

  # §2.4.1 — require session name positional argument
  if [[ -z "${session}" ]]; then
    die_usage "Missing required argument: <session>"
  fi

  # Resolve session title/ID → session ID (§2.4.2, §2.4.5)
  get_sessions
  local session_id
  session_id=$(printf '%s' "${SESSION_DATA}" | \
    jq -r --arg q "${session}" \
    'first(.[] | select(.title == $q or .id == $q) | .id) // empty' 2>/dev/null)

  if [[ -z "${session_id}" ]]; then
    die "Session not found: ${session}"
  fi

  # Export session data (§2.4.2)
  local export_json
  export_json=$(opencode export "${session_id}" 2>/dev/null) || \
    die "Failed to export session: ${session}"

  if [[ -z "${export_json}" ]]; then
    die "Session export returned empty: ${session}"
  fi

  # JSON output mode (§3.5)
  if [[ "${JSON_OUTPUT:-false}" == "true" ]]; then
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local messages_json
    messages_json=$(printf '%s' "${export_json}" | jq -c '
      [.messages[] |
       .info.role as $role |
       .parts[] |
       select(.type == "text") |
       {role: $role, text: .text}]
    ' 2>/dev/null) || messages_json="[]"
    jq -n \
      --arg ts "${timestamp}" \
      --arg id "${session_id}" \
      --arg title "${session}" \
      --argjson msgs "${messages_json}" \
      '{timestamp: $ts, session_id: $id, session_title: $title, messages: $msgs}'
    return 0
  fi

  # Human-readable output (§2.4.3 — strip raw JSON, present assistant messages readably)
  printf '%s%s — Session Log%s\n' "${BOLD}" "${session}" "${RESET}"
  printf '%s%s%s\n\n' "${DIM}" "$(printf '%.0s─' {1..60})" "${RESET}"

  local prev_role=""
  while IFS=$'\t' read -r part_role part_type part_text part_tool part_status; do
    if [[ "${part_type}" == "text" ]]; then
      if [[ "${part_role}" != "${prev_role}" ]]; then
        if [[ "${part_role}" == "user" ]]; then
          printf '%s╔ User ═══════════════════════════════════════════╗%s\n' "${CYAN}" "${RESET}"
        else
          printf '%s╔ Assistant ══════════════════════════════════════╗%s\n' "${GREEN}" "${RESET}"
        fi
        prev_role="${part_role}"
      fi
      printf '%s\n' "${part_text}"
    elif [[ "${part_type}" == "tool" && -n "${part_tool}" ]]; then
      printf '  %s[%s] %s%s\n' "${DIM}" "${part_tool}" "${part_status}" "${RESET}"
    fi
  done < <(printf '%s' "${export_json}" | jq -r '
    .messages[] |
    .info.role as $role |
    .parts[] |
    if .type == "text" then
      [$role, "text", .text, "", ""]
    elif .type == "tool" and (.tool != null) then
      [$role, "tool", "", (.tool), (.state.status // "")]
    else
      empty
    end |
    @tsv
  ' 2>/dev/null)
}

# cmd_tail — live-follow a running session's output log
cmd_tail() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h) tail_usage; return 0 ;;
      --) shift; break ;;
      -*) die_usage "Unknown option for 'tail': $1" ;;
      *)  break ;;
    esac
  done

  # §2.5.1 — require session name positional argument
  local session="${1:-}"
  if [[ -z "${session}" ]]; then
    die_usage "Missing required argument: <session>"
  fi

  local log_file="${LOG_DIR}/gsd-${session}.log"

  # §2.5.5 — error if log file does not exist
  if [[ ! -f "${log_file}" ]]; then
    die "No log file found for session '${session}': ${log_file}"
  fi

  # §2.5.4 — clean Ctrl-C exit with trap
  # shellcheck disable=SC2064
  trap "printf '\n%sStopped following: %s%s\n' '${DIM}' '${session}' '${RESET}'; exit 0" INT

  printf '%sFollowing session: %s%s\n' "${BOLD}" "${session}" "${RESET}"
  printf '%s%s%s\n' "${DIM}" "$(printf '%.0s─' {1..60})" "${RESET}"
  printf '%s(Ctrl-C to stop)%s\n\n' "${DIM}" "${RESET}"

  # §2.5.3 — use tail -f for live following (inotifywait not available on this system)
  tail -f "${log_file}"
}

# ── Usage / Help ───────────────────────────────────────────────────────────────

usage() {
  printf '%s%s%s — GSD Pipeline Monitor v%s\n\n' "${BOLD}" "${PROG_NAME}" "${RESET}" "${VERSION}"
  printf '%sUsage:%s\n' "${BOLD}" "${RESET}"
  printf '  %s [global-options] <command> [command-options]\n\n' "${PROG_NAME}"
  printf '%sCommands:%s\n' "${BOLD}" "${RESET}"
  printf '  %-20s %s\n' 'status'       'Show pipeline dashboard (running, stuck, queued, completed) [default]'
  printf '  %-20s %s\n' 'queue, q'     'Pretty-print QUEUE.md pipeline task list'
  printf '  %-20s %s\n' 'stuck'        'Find hung processes (optionally kill them)'
  printf '  %-20s %s\n' 'log <session>' 'Show readable transcript of an opencode session'
  printf '  %-20s %s\n' 'tail <session>' 'Live-follow a running session output'
  printf '  %-20s %s\n' 'help'          'Show this help message'
  printf '\n%sGlobal Options:%s\n' "${BOLD}" "${RESET}"
  printf '  %-20s %s\n' '-v, --verbose'  'Show verbose output (full tables, debug messages)'
  printf '  %-20s %s\n' '--json'         'Output as JSON (disables colors)'
  printf '  %-20s %s\n' '-h, --help'     'Show this help message'
  printf '  %-20s %s\n' '--version'      'Print version string and exit'
  printf '\n%sEnvironment Variables:%s\n' "${BOLD}" "${RESET}"
  printf '  %-24s %s\n' 'GSD_QUEUE_FILE'      "Path to QUEUE.md (default: ~/dev/punchlab/QUEUE.md)"
  printf '  %-24s %s\n' 'GSD_LOG_DIR'         "Log directory (default: /tmp)"
  printf '  %-24s %s\n' 'GSD_STUCK_THRESHOLD' "Stuck threshold in minutes (default: 30)"
  printf '  %-24s %s\n' 'NO_COLOR'            "Disable ANSI colors (https://no-color.org/)"
  printf '\n%sExamples:%s\n' "${BOLD}" "${RESET}"
  printf '  %s                        # Show dashboard\n' "${PROG_NAME}"
  printf '  %s --verbose              # Full tables with all columns\n' "${PROG_NAME}"
  printf '  %s --json | jq .summary  # Machine-readable output\n' "${PROG_NAME}"
  printf '  %s stuck --kill          # Kill stuck sessions\n' "${PROG_NAME}"
  printf '  %s log my-session        # View session transcript\n' "${PROG_NAME}"
  printf '  %s tail my-session       # Stream live session output\n' "${PROG_NAME}"
}

# ── Main Dispatch ──────────────────────────────────────────────────────────────

main() {
  setup_colors

  # Runtime state (not configuration — initialized here, not as global constants)
  local VERBOSE=false
  local JSON_OUTPUT=false

  # Parse global flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --verbose|-v)
        VERBOSE=true
        shift
        ;;
      --json)
        JSON_OUTPUT=true
        # Disable colors in JSON mode (§3.1.5)
        RED='' GREEN='' YELLOW='' BLUE='' CYAN=''
        BOLD='' DIM='' BOLD_RED='' RESET=''
        shift
        ;;
      --help|-h)
        usage
        return 0
        ;;
      --version)
        printf '%s\n' "${PROG_NAME} ${VERSION}"
        return 0
        ;;
      --)
        shift
        break
        ;;
      -*)
        die_usage "Unknown option: $1"
        ;;
      *)
        break
        ;;
    esac
  done

  # Export runtime state so subcommands can see it
  export VERBOSE JSON_OUTPUT

  local cmd="${1:-status}"
  shift || true

  # Check dependencies before dispatching (fail fast)
  check_deps

  # Dispatch to subcommand
  case "${cmd}" in
    status)       cmd_status "$@" ;;
    queue|q)      cmd_queue "$@" ;;
    stuck)        cmd_stuck "$@" ;;
    log)          cmd_log "$@" ;;
    tail)         cmd_tail "$@" ;;
    help)         usage ;;
    *)            die_usage "Unknown command: ${cmd}. Run '${PROG_NAME} --help' for usage." ;;
  esac
}

main "$@"
