#!/usr/bin/env bash
set -euo pipefail

# ── Constants ──────────────────────────────────────────────────────────────────
readonly VERSION="0.1.0"
readonly QUEUE_FILE="${GSD_QUEUE_FILE:-$HOME/dev/punchlab/QUEUE.md}"
readonly LOG_DIR="${GSD_LOG_DIR:-/tmp}"
# NOTE: STUCK_THRESHOLD_MIN is NOT readonly — the --threshold flag can override it at runtime
STUCK_THRESHOLD_MIN="${GSD_STUCK_THRESHOLD:-90}"
readonly PROG_NAME="gsd"

# ── Color Variables ────────────────────────────────────────────────────────────
# Not readonly — set by setup_colors() based on TTY detection
RED='' GREEN='' YELLOW='' BLUE='' CYAN=''
BOLD='' DIM='' BOLD_RED='' RESET=''

# ── Utility Functions ──────────────────────────────────────────────────────────

# setup_colors — enable ANSI colors if stdout is a TTY and NO_COLOR is not set
setup_colors() {
  if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]] && [[ "${TERM:-}" != "dumb" ]]; then
    RED=$'\033[0;31m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[0;33m'
    BLUE=$'\033[0;34m'
    CYAN=$'\033[0;36m'
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    BOLD_RED=$'\033[1;31m'
    RESET=$'\033[0m'
  else
    RED='' GREEN='' YELLOW='' BLUE='' CYAN=''
    BOLD='' DIM='' BOLD_RED='' RESET=''
  fi
}

# err — print an error message to stderr (styled red)
err() {
  printf '%sError: %s%s\n' "${RED}" "$*" "${RESET}" >&2
}

# warn — print a warning message to stderr (styled yellow)
warn() {
  printf '%sWarning: %s%s\n' "${YELLOW}" "$*" "${RESET}" >&2
}

# debug — print a debug message to stderr ONLY if VERBOSE=true (styled dim)
debug() {
  if [[ "${VERBOSE:-false}" == "true" ]]; then
    printf '%s[debug] %s%s\n' "${DIM}" "$*" "${RESET}" >&2
  fi
}

# die — print error and exit with code 1 (runtime error)
die() {
  err "$@"
  exit 1
}

# die_usage — print error + help hint and exit with code 2 (usage error)
die_usage() {
  err "$@"
  printf "Run '%s --help' for usage.\n" "${PROG_NAME}" >&2
  exit 2
}

# cleanup — remove temp file if set; registered via trap
cleanup() {
  [[ -n "${TMPFILE:-}" ]] && rm -f "${TMPFILE}" || true
}
trap cleanup EXIT

# check_deps — verify jq and opencode are installed; die with install instructions if not
check_deps() {
  local missing=()

  if ! command -v jq &>/dev/null; then
    missing+=("jq")
  fi

  if ! command -v opencode &>/dev/null; then
    missing+=("opencode")
  fi

  if [[ ${#missing[@]} -gt 0 ]]; then
    for dep in "${missing[@]}"; do
      case "${dep}" in
        jq)
          err "Missing required dependency: jq"
          printf '  Install jq:\n' >&2
          printf '    macOS:   brew install jq\n' >&2
          printf '    Ubuntu:  sudo apt-get install jq\n' >&2
          printf '    Fedora:  sudo dnf install jq\n' >&2
          printf '    Other:   https://jqlang.github.io/jq/download/\n' >&2
          ;;
        opencode)
          err "Missing required dependency: opencode"
          printf '  Install opencode:\n' >&2
          printf '    npm install -g opencode-ai\n' >&2
          printf '    Or visit: https://opencode.ai\n' >&2
          ;;
      esac
    done
    exit 1
  fi
}

# format_duration — format seconds into human-readable string: Xh Ym / Xm Ys / Xs
format_duration() {
  local seconds="$1"

  # Guard against non-numeric input
  if [[ ! "${seconds}" =~ ^[0-9]+$ ]]; then
    printf 'unknown'
    return
  fi

  local hours minutes
  hours=$(( seconds / 3600 ))
  minutes=$(( (seconds % 3600) / 60 ))

  if (( hours > 0 )); then
    printf '%dh %dm' "${hours}" "${minutes}"
  elif (( minutes > 0 )); then
    printf '%dm %ds' "${minutes}" $(( seconds % 60 ))
  else
    printf '%ds' "${seconds}"
  fi
}

# ── Formatting Functions ───────────────────────────────────────────────────────

# print_header — print a bold+blue section header with a dim separator line
print_header() {
  printf '%s%s%s\n' "${BOLD}${BLUE}" "$1" "${RESET}"
  printf '%s%s%s\n' "${DIM}" "$(printf '%.0s─' {1..60})" "${RESET}"
}

# print_table_header — print a bold table header row and dim separator
# Usage: print_table_header "%-20s %-8s %-10s" "SESSION" "STATUS" "DURATION"
print_table_header() {
  local fmt="$1"
  shift
  # shellcheck disable=SC2059
  printf "${BOLD}${fmt}${RESET}\n" "$@"
  printf '%s%s%s\n' "${DIM}" "$(printf '%.0s─' {1..60})" "${RESET}"
}

# truncate_str — truncate a string to max_width, appending … if truncated
truncate_str() {
  local str="$1"
  local max_width="$2"

  if [[ ${#str} -gt ${max_width} ]]; then
    printf '%s…' "${str:0:$(( max_width - 1 ))}"
  else
    printf '%s' "${str}"
  fi
}

# ── Data Functions ─────────────────────────────────────────────────────────────

# Global cache for session data (populated by get_sessions)
SESSION_DATA="[]"

# get_sessions — call opencode session list once and cache result in SESSION_DATA
get_sessions() {
  local json
  json=$(opencode session list --format json 2>/dev/null) || json="[]"

  # Validate the output is a valid JSON array
  if printf '%s' "${json}" | jq -e 'type == "array"' &>/dev/null; then
    SESSION_DATA="${json}"
  else
    debug "opencode session list returned invalid JSON; using empty session list"
    SESSION_DATA="[]"
  fi
}

# get_running_sessions — filter SESSION_DATA for running/active sessions
# Outputs a JSON array of running sessions
get_running_sessions() {
  # opencode session list has no 'status' field — cross-reference with PID files
  # A session is "running" if its title matches a live PID file
  local result="[]"
  local count
  count=$(printf '%s' "${SESSION_DATA}" | jq 'length' 2>/dev/null) || count=0
  [[ "${count}" -eq 0 ]] && printf '%s' "${result}" && return

  # Build a list of active session titles from PID files
  local active_titles=()
  local pid_file
  for pid_file in "${LOG_DIR}"/gsd-*-pid; do
    [[ -f "${pid_file}" ]] || continue
    local title
    title="${pid_file##*/gsd-}"
    title="${title%-pid}"
    local pid
    pid=$(< "${pid_file}")
    if kill -0 "${pid}" 2>/dev/null; then
      active_titles+=("${title}")
    fi
  done

  if [[ ${#active_titles[@]} -eq 0 ]]; then
    printf '%s' "${result}"
    return
  fi

  # Filter SESSION_DATA to sessions matching an active title
  local titles_json
  titles_json=$(printf '%s\n' "${active_titles[@]}" | jq -Rsc '[split("\n")[] | select(length > 0)]')
  result=$(printf '%s' "${SESSION_DATA}" | \
    jq -c --argjson titles "${titles_json}" \
    '[.[] | select(.title as $t | $titles | contains([$t]))]' 2>/dev/null) || result="[]"
  printf '%s' "${result}"
}

# get_completed_sessions — extract completed/finished sessions, last 5, newest first
get_completed_sessions() {
  # Return the last 5 sessions that are NOT currently running (have no live PID file)
  # Sort by .updated (epoch ms), newest first
  local completed
  completed=$(printf '%s' "${SESSION_DATA}" | \
    jq -c '[.] |
           flatten |
           sort_by(.updated) |
           reverse |
           .[0:5]' 2>/dev/null) || completed="[]"
  printf '%s' "${completed}"
}

# check_stuck — check if a session is stuck by examining its PID file and log file
# Arguments: $1 = session name/id
# Outputs: status string to stdout (running, stuck, not_found, not_running)
# Sets global STUCK_RUNTIME and STUCK_LOG_STALENESS for caller inspection
STUCK_RUNTIME=0
STUCK_LOG_STALENESS=0

check_stuck() {
  local session="$1"
  local pid_file="${LOG_DIR}/gsd-${session}-pid"
  local log_file="${LOG_DIR}/gsd-${session}.log"

  STUCK_RUNTIME=0
  STUCK_LOG_STALENESS=0

  if [[ ! -f "${pid_file}" ]]; then
    printf 'not_found'
    return
  fi

  local pid
  pid=$(< "${pid_file}")

  # Verify the PID is still alive
  if ! kill -0 "${pid}" 2>/dev/null; then
    # Stale PID file — remove it silently
    rm -f "${pid_file}"
    printf 'not_running'
    return
  fi

  # Get runtime in seconds
  local runtime
  runtime=$(ps -o etimes= -p "${pid}" 2>/dev/null) || runtime=0
  runtime="${runtime// /}"  # strip whitespace
  STUCK_RUNTIME="${runtime:-0}"

  # Get log staleness
  local now
  now=$(date +%s)

  if [[ -f "${log_file}" ]]; then
    local log_mtime
    log_mtime=$(stat -c %Y "${log_file}" 2>/dev/null) || log_mtime="${now}"
    STUCK_LOG_STALENESS=$(( now - log_mtime ))
  else
    # No log file — treat as potentially stuck if runtime > threshold
    STUCK_LOG_STALENESS=9999
  fi

  local threshold_seconds
  threshold_seconds=$(( STUCK_THRESHOLD_MIN * 60 ))
  local stale_threshold=300  # 5 minutes in seconds

  # Check CPU usage — if process is actively working (>0.5% CPU), it's not stuck
  local cpu_usage
  cpu_usage=$(ps -o %cpu= -p "${pid}" 2>/dev/null) || cpu_usage="0"
  cpu_usage="${cpu_usage// /}"
  # Compare as integer (multiply by 10 to handle decimals)
  local cpu_int
  cpu_int=$(printf '%.0f' "$(echo "${cpu_usage} * 10" | bc 2>/dev/null)" 2>/dev/null) || cpu_int=0

  if [[ "${STUCK_RUNTIME}" -gt "${threshold_seconds}" ]] && \
     [[ "${STUCK_LOG_STALENESS}" -gt "${stale_threshold}" ]] && \
     [[ "${cpu_int}" -lt 5 ]]; then
    # Only stuck if: over threshold + stale log + near-zero CPU (<0.5%)
    printf 'stuck'
  else
    printf 'running'
  fi
}

# get_queue_items — parse QUEUE.md and output tab-delimited items: status\tname\tdescription
# Uses tab as delimiter to avoid conflicts with | characters in QUEUE.md content
get_queue_items() {
  if [[ ! -f "${QUEUE_FILE}" ]]; then
    debug "Queue file not found: ${QUEUE_FILE}"
    return 0
  fi

  local current_section=""
  local line

  while IFS= read -r line; do
    # Skip comment lines (starting with #)
    [[ "${line}" =~ ^# ]] && continue

    # Detect section headers: ## In Progress, ## Queued, ## Done, ## Failed, ## Current Queue, etc.
    if [[ "${line}" =~ ^##[[:space:]]+(.+)$ ]]; then
      current_section="${BASH_REMATCH[1]}"
      continue
    fi

    # Parse task lines: - [ ] description or - [x] description
    # Also handles ~, !, S checkbox variants
    if [[ "${line}" =~ ^-[[:space:]]+\[([[:space:]xX~!S])\][[:space:]]+(.+)$ ]]; then
      local checkbox="${BASH_REMATCH[1]}"
      local description="${BASH_REMATCH[2]}"

      # Determine status from section header (not checkbox)
      local status
      case "${current_section}" in
        "In Progress"|"in progress"|"IN PROGRESS"|"Current Queue"|"current queue")
          # Check checkbox for in-progress vs queued in generic sections
          if [[ "${checkbox}" == "~" ]]; then
            status="in_progress"
          elif [[ "${checkbox}" == " " ]]; then
            status="queued"
          elif [[ "${checkbox}" == "!" ]]; then
            status="failed"
          elif [[ "${checkbox}" == "S" ]]; then
            status="done"
          elif [[ "${checkbox}" =~ [xX] ]]; then
            status="done"
          else
            status="queued"
          fi
          ;;
        "Queued"|"queued"|"QUEUED"|"To Do"|"TODO")
          status="queued"
          ;;
        "Done"|"done"|"DONE"|"Completed"|"completed")
          status="done"
          ;;
        "Failed"|"failed"|"FAILED")
          status="failed"
          ;;
        *)
          # Fall back to checkbox state if no recognizable section
          case "${checkbox}" in
            " ") status="queued" ;;
            "~") status="in_progress" ;;
            "!") status="failed" ;;
            [xXS]) status="done" ;;
            *) status="queued" ;;
          esac
          ;;
      esac

      # Extract name from description.
      # Supports two formats:
      #   1. "name: description" (from requirements spec)
      #   2. "name | file | phases" (actual QUEUE.md format)
      local name desc
      if [[ "${description}" =~ ^([^:|]+)\|(.*)$ ]]; then
        # Pipe-delimited format: extract first field as name, trim whitespace
        name="${BASH_REMATCH[1]}"
        desc="${BASH_REMATCH[2]}"
        # Trim leading/trailing whitespace from name
        name="${name#"${name%%[![:space:]]*}"}"
        name="${name%"${name##*[![:space:]]}"}"
        desc="${desc#"${desc%%[![:space:]]*}"}"
        desc="${desc%"${desc##*[![:space:]]}"}"
      elif [[ "${description}" =~ ^([^:]+):[[:space:]]*(.+)$ ]]; then
        # Colon-delimited format
        name="${BASH_REMATCH[1]}"
        desc="${BASH_REMATCH[2]}"
      else
        name="${description}"
        desc=""
      fi

      # Output as tab-delimited (tab is safe since markdown doesn't use tabs in content)
      printf '%s\t%s\t%s\n' "${status}" "${name}" "${desc}"
    fi
    # Silently skip malformed lines (§2.2.7)
  done < "${QUEUE_FILE}"
}

