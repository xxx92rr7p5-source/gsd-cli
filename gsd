# ── Subcommand Functions ───────────────────────────────────────────────────────

# cmd_status — show the GSD pipeline status dashboard
cmd_status() {
  local verbose="${VERBOSE:-false}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --verbose|-v) verbose=true; shift ;;
      --help|-h)    status_usage; return 0 ;;
      --)           shift; break ;;
      -*)           die_usage "Unknown option for 'status': $1" ;;
      *)            break ;;
    esac
  done

  # Gather data
  get_sessions
  local running_json
  running_json=$(get_running_sessions)
  local completed_json
  completed_json=$(get_completed_sessions)

  # Parse running sessions into arrays
  local running_count
  running_count=$(printf '%s' "${running_json}" | jq 'length' 2>/dev/null) || running_count=0

  local completed_count
  completed_count=$(printf '%s' "${completed_json}" | jq 'length' 2>/dev/null) || completed_count=0

  # Parse queue items (tab-delimited: status\tname\tdescription)
  local queue_items=()
  local queue_count=0
  if [[ -f "${QUEUE_FILE}" ]]; then
    while IFS=$'\t' read -r q_status q_name q_desc; do
      # Only include active items (queued or in_progress)
      if [[ "${q_status}" == "queued" || "${q_status}" == "in_progress" ]]; then
        queue_items+=("${q_status}	${q_name}	${q_desc}")
        (( queue_count++ )) || true
      fi
    done < <(get_queue_items 2>/dev/null || true)
  fi

  # Check for stuck sessions
  local stuck_count=0

  # JSON output mode
  if [[ "${JSON_OUTPUT:-false}" == "true" ]]; then
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    # Build queue JSON safely by converting tab-delimited output to JSON
    local all_queue_items
    all_queue_items=$(get_queue_items 2>/dev/null | \
      jq -Rr 'split("\t") | if length >= 2 then
        {status: .[0], name: .[1], description: (.[2] // "")}
      else empty end' 2>/dev/null | \
      jq -sc '.' 2>/dev/null) || all_queue_items="[]"
    [[ "${all_queue_items}" == "null" || -z "${all_queue_items}" ]] && all_queue_items="[]"

    jq -n \
      --arg timestamp "${timestamp}" \
      --argjson running_count "${running_count}" \
      --argjson stuck_count "${stuck_count}" \
      --argjson queue_count "${queue_count}" \
      --argjson sessions_running "${running_json}" \
      --argjson sessions_completed "${completed_json}" \
      --argjson queue "${all_queue_items}" \
      '{
        timestamp: $timestamp,
        summary: {
          running: $running_count,
          stuck: $stuck_count,
          queued: $queue_count
        },
        sessions: {
          running: $sessions_running,
          stuck: []
        },
        queue: $queue,
        completed: $sessions_completed
      }'
    return 0
  fi

  # Human-readable output
  printf '%s%s GSD Status%s\n' "${BOLD}" "📊" "${RESET}"
  printf '%s%s%s\n\n' "${DIM}" "$(printf '%.0s─' {1..60})" "${RESET}"

  # Summary counts
  local running_color="${GREEN}"
  local stuck_color="${RED}"
  local queue_color="${YELLOW}"

  printf '%s%d running%s  %s%d stuck%s  %s%d queued%s\n\n' \
    "${running_color}" "${running_count}" "${RESET}" \
    "${stuck_color}" "${stuck_count}" "${RESET}" \
    "${queue_color}" "${queue_count}" "${RESET}"

  # Empty state
  if [[ "${running_count}" -eq 0 ]] && [[ "${queue_count}" -eq 0 ]] && [[ "${completed_count}" -eq 0 ]]; then
    printf '%sNo active sessions. Queue is empty. All clear!%s\n' "${DIM}" "${RESET}"
    return 0
  fi

  if [[ "${verbose}" == "true" ]]; then
    # Verbose: full tables
    if [[ "${running_count}" -gt 0 ]]; then
      print_header "Running Sessions"
      print_table_header "%-20s %-10s %-8s %-12s %-15s" \
        "SESSION" "STATUS" "PID" "DURATION" "LOG ACTIVITY"
      while IFS=$'\t' read -r sess status pid dur updated; do
        local short_sess
        short_sess=$(truncate_str "${sess}" 20)
        printf '%-20s %-10s %-8s %-12s %-15s\n' \
          "${short_sess}" "${status}" "${pid}" "${dur}" "${updated}"
      done < <(printf '%s' "${running_json}" | jq -r '.[] | [
        (.id // .name // "unknown"),
        (.status // "running"),
        (.pid // "N/A" | tostring),
        (.duration // "N/A" | tostring),
        (.updated_at // "N/A")
      ] | @tsv' 2>/dev/null)
      printf '\n'
    fi

    if [[ "${queue_count}" -gt 0 ]]; then
      print_header "Queue"
      print_table_header "%-12s %-25s %s" "STATUS" "NAME" "DESCRIPTION"
      for item in "${queue_items[@]}"; do
        local s n d
        IFS=$'\t' read -r s n d <<< "${item}"
        local color
        case "${s}" in
          in_progress) color="${GREEN}" ;;
          queued)      color="${YELLOW}" ;;
          *) color="${RESET}" ;;
        esac
        local short_n
        short_n=$(truncate_str "${n}" 25)
        printf '%s%-12s %-25s %s%s\n' "${color}" "${s}" "${short_n}" "${d}" "${RESET}"
      done
      printf '\n'
    fi

    if [[ "${completed_count}" -gt 0 ]]; then
      print_header "Completed (last 5)"
      print_table_header "%-20s %-10s %s" "SESSION" "STATUS" "FINISHED"
      while IFS=$'\t' read -r sess status finished; do
        local short_sess color
        short_sess=$(truncate_str "${sess}" 20)
        case "${status}" in
          done|completed|finished) color="${DIM}" ;;
          failed) color="${RED}" ;;
          *) color="${DIM}" ;;
        esac
        printf '%s%-20s %-10s %s%s\n' "${color}" "${short_sess}" "${status}" "${finished}" "${RESET}"
      done < <(printf '%s' "${completed_json}" | jq -r '.[] | [
        (.id // .name // "unknown"),
        (.status // "done"),
        (.updated_at // "N/A")
      ] | @tsv' 2>/dev/null)
      printf '\n'
    fi

  else
    # Compact view
    if [[ "${running_count}" -gt 0 ]]; then
      print_header "Running"
      while IFS= read -r sess; do
        printf '  %s●%s %s\n' "${GREEN}" "${RESET}" "${sess}"
      done < <(printf '%s' "${running_json}" | jq -r '.[] | (.id // .name // "unknown")' 2>/dev/null)
      printf '\n'
    else
      printf '%sNo running sessions%s\n\n' "${DIM}" "${RESET}"
    fi

    if [[ "${queue_count}" -gt 0 ]]; then
      print_header "Queued"
      local shown=0
      for item in "${queue_items[@]}"; do
        if [[ "${shown}" -ge 3 ]]; then
          printf '  %s... and %d more%s\n' "${DIM}" "$(( queue_count - shown ))" "${RESET}"
          break
        fi
        local s n d
        IFS=$'\t' read -r s n d <<< "${item}"
        local icon
        case "${s}" in
          in_progress) icon="⟳" ;;
          *) icon="○" ;;
        esac
        printf '  %s %s\n' "${icon}" "${n}"
        (( shown++ )) || true
      done
      printf '\n'
    fi

    if [[ "${completed_count}" -gt 0 ]]; then
      print_header "Recently Completed"
      while IFS= read -r line; do
        printf '  %s✓%s %s\n' "${DIM}" "${RESET}" "${line}"
      done < <(printf '%s' "${completed_json}" | jq -r '.[] | (.id // .name // "unknown") + " (" + (.status // "done") + ")"' 2>/dev/null)
      printf '\n'
    fi
  fi
}

# cmd_queue — pretty-print QUEUE.md
cmd_queue() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h) queue_usage; return 0 ;;
      --)        shift; break ;;
      -*)        die_usage "Unknown option for 'queue': $1" ;;
      *)         break ;;
    esac
  done

  printf '%sQueue: %s%s\n' "${BOLD}" "${QUEUE_FILE}" "${RESET}"
  printf '%s%s%s\n\n' "${DIM}" "$(printf '%.0s─' {1..60})" "${RESET}"

  if [[ ! -f "${QUEUE_FILE}" ]]; then
    die "Queue file not found: ${QUEUE_FILE}"
  fi

  local current_section=""
  local line

  while IFS= read -r line; do
    if [[ "${line}" =~ ^##[[:space:]]+(.+)$ ]]; then
      current_section="${BASH_REMATCH[1]}"
      printf '\n%s%s%s\n' "${BOLD}" "${current_section}" "${RESET}"
      continue
    fi

    if [[ "${line}" =~ ^-[[:space:]]+\[([[:space:]xX])\][[:space:]]+(.+)$ ]]; then
      local checkbox="${BASH_REMATCH[1]}"
      local description="${BASH_REMATCH[2]}"
      local color icon

      case "${current_section}" in
        "In Progress"|"in progress")
          color="${GREEN}"; icon="⟳" ;;
        "Queued"|"queued"|"To Do")
          color="${YELLOW}"; icon="○" ;;
        "Done"|"done"|"Completed")
          color="${DIM}"; icon="✓" ;;
        "Failed"|"failed")
          color="${RED}"; icon="✗" ;;
        *)
          if [[ "${checkbox}" == " " ]]; then
            color="${YELLOW}"; icon="○"
          else
            color="${DIM}"; icon="✓"
          fi
          ;;
      esac

      printf '  %s%s %s%s\n' "${color}" "${icon}" "${description}" "${RESET}"
    fi
  done < "${QUEUE_FILE}"
}

# cmd_stuck — find stuck opencode sessions
cmd_stuck() {
  local kill_stuck=false
  local force=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --kill|-k)
        kill_stuck=true; shift ;;
      --force|-f)
        force=true; shift ;;
      --threshold|-t)
        if [[ -z "${2:-}" ]]; then
          die_usage "Option $1 requires a numeric argument"
        fi
        if [[ ! "${2}" =~ ^[0-9]+$ ]]; then
          die_usage "Invalid threshold value '${2}': must be a positive integer"
        fi
        STUCK_THRESHOLD_MIN="$2"
        shift 2
        ;;
      --help|-h)
        stuck_usage; return 0 ;;
      --)
        shift; break ;;
      -*)
        die_usage "Unknown option for 'stuck': $1" ;;
      *)
        break ;;
    esac
  done

  printf 'Stuck detection coming soon (Plan 02 implements this fully)\n'
  printf 'Threshold: %s minutes\n' "${STUCK_THRESHOLD_MIN}"
}

# cmd_log — show a readable session transcript
cmd_log() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h) log_usage; return 0 ;;
      --) shift; break ;;
      -*) die_usage "Unknown option for 'log': $1" ;;
      *)  break ;;
    esac
  done

  local session="${1:-}"
  if [[ -z "${session}" ]]; then
    die_usage "Missing required argument: <session>"
  fi

  printf 'Session log for: %s\n' "${session}"
  printf 'Log viewer coming in a future plan\n'
}

# cmd_tail — live-follow a session's output
cmd_tail() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h) tail_usage; return 0 ;;
      --) shift; break ;;
      -*) die_usage "Unknown option for 'tail': $1" ;;
      *)  break ;;
    esac
  done

  local session="${1:-}"
  if [[ -z "${session}" ]]; then
    die_usage "Missing required argument: <session>"
  fi

  printf 'Following session: %s\n' "${session}"
  printf 'Live tail coming in a future plan\n'
}

# ── Usage / Help ───────────────────────────────────────────────────────────────

usage() {
  printf '%s%s%s — GSD Pipeline Monitor v%s\n\n' "${BOLD}" "${PROG_NAME}" "${RESET}" "${VERSION}"
  printf '%sUsage:%s\n' "${BOLD}" "${RESET}"
  printf '  %s [global-options] <command> [command-options]\n\n' "${PROG_NAME}"
  printf '%sCommands:%s\n' "${BOLD}" "${RESET}"
  printf '  %-20s %s\n' 'status'       'Show pipeline dashboard (running, stuck, queued, completed) [default]'
  printf '  %-20s %s\n' 'queue, q'     'Pretty-print QUEUE.md pipeline task list'
  printf '  %-20s %s\n' 'stuck'        'Find hung processes (optionally kill them)'
  printf '  %-20s %s\n' 'log <session>' 'Show readable transcript of an opencode session'
  printf '  %-20s %s\n' 'tail <session>' 'Live-follow a running session output'
  printf '  %-20s %s\n' 'help'          'Show this help message'
  printf '\n%sGlobal Options:%s\n' "${BOLD}" "${RESET}"
  printf '  %-20s %s\n' '-v, --verbose'  'Show verbose output (full tables, debug messages)'
  printf '  %-20s %s\n' '--json'         'Output as JSON (disables colors)'
  printf '  %-20s %s\n' '-h, --help'     'Show this help message'
  printf '  %-20s %s\n' '--version'      'Print version string and exit'
  printf '\n%sEnvironment Variables:%s\n' "${BOLD}" "${RESET}"
  printf '  %-24s %s\n' 'GSD_QUEUE_FILE'      "Path to QUEUE.md (default: ~/dev/punchlab/QUEUE.md)"
  printf '  %-24s %s\n' 'GSD_LOG_DIR'         "Log directory (default: /tmp)"
  printf '  %-24s %s\n' 'GSD_STUCK_THRESHOLD' "Stuck threshold in minutes (default: 30)"
  printf '  %-24s %s\n' 'NO_COLOR'            "Disable ANSI colors (https://no-color.org/)"
  printf '\n%sExamples:%s\n' "${BOLD}" "${RESET}"
  printf '  %s                        # Show dashboard\n' "${PROG_NAME}"
  printf '  %s --verbose              # Full tables with all columns\n' "${PROG_NAME}"
  printf '  %s --json | jq .summary  # Machine-readable output\n' "${PROG_NAME}"
