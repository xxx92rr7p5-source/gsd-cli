# ── Main Dispatch ──────────────────────────────────────────────────────────────

main() {
  setup_colors

  # Runtime state (not configuration — initialized here, not as global constants)
  local VERBOSE=false
  local JSON_OUTPUT=false

  # Parse global flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --verbose|-v)
        VERBOSE=true
        shift
        ;;
      --json)
        JSON_OUTPUT=true
        # Disable colors in JSON mode (§3.1.5)
        RED='' GREEN='' YELLOW='' BLUE='' CYAN=''
        BOLD='' DIM='' BOLD_RED='' RESET=''
        shift
        ;;
      --help|-h)
        usage
        return 0
        ;;
      --version)
        printf '%s\n' "${PROG_NAME} ${VERSION}"
        return 0
        ;;
      --)
        shift
        break
        ;;
      -*)
        die_usage "Unknown option: $1"
        ;;
      *)
        break
        ;;
    esac
  done

  # Export runtime state so subcommands can see it
  export VERBOSE JSON_OUTPUT

  local cmd="${1:-status}"
  shift || true

  # Check dependencies before dispatching (fail fast)
  check_deps

  # Dispatch to subcommand
  case "${cmd}" in
    status)       cmd_status "$@" ;;
    queue|q)      cmd_queue "$@" ;;
    stuck)        cmd_stuck "$@" ;;
    log)          cmd_log "$@" ;;
    tail)         cmd_tail "$@" ;;
    help)         usage ;;
    *)            die_usage "Unknown command: ${cmd}. Run '${PROG_NAME} --help' for usage." ;;
  esac
}

main "$@"
